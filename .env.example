# Copy to .env.local. Leave empty to use the offline mock dialogue provider.
# URL of the LLM dialogue service (POST DialogueRequest -> DialogueScript JSON).
# The service holds the LLM API key; never put the key in this file.
# With the Vite dev proxy you can use relative paths: VITE_DIALOGUE_API=/api and VITE_DIRECTOR_API=/api/director
VITE_DIALOGUE_API=
# URL of the LLM Director service (POST DirectorRequest -> FloorDirective JSON). Empty = <VITE_DIALOGUE_API>/director, or the offline mock when that is empty too.
VITE_DIRECTOR_API=
