# Copy to server/.env (git-ignored). Never commit a real key.
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
# Fail the LLM call after this many ms (Gemini minimum is 10000; client aborts at 15000).
LLM_TIMEOUT_MS=12000
# Scripts cached by request seed.
CACHE_SIZE=500
# Max LLM calls (cache misses) per client IP per minute.
RATE_LIMIT_PER_MIN=30
# Comma-separated allowed origins, or * for any.
CORS_ORIGIN=*
